# Copie ce fichier en .env et remplis-le.

# Mot de passe de l'admin (/admin). Sans lui, l'admin est désactivée.
ADMIN_PASSWORD=

# Port d'écoute (défaut : 3000).
PORT=3000

# Dossier où sont stockés le planning et le profil (défaut : ./data).
# Sur un hébergeur, pointe-le vers un disque persistant.
# DATA_DIR=/var/data/yiep

# Adresse publique du site, utilisée pour les aperçus Discord / X.
# SITE_URL=https://yiep.io

# Mettre à 1 derrière un proxy (Render, Railway, Nginx…).
# TRUST_PROXY=1
